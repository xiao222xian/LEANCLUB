[Unit]
Description=LEAN SCHOOL dedicated Redis cache
After=network.target

[Service]
Type=simple
User=leanschool
Group=leanschool
ExecStart=/usr/bin/redis-server /etc/leanschool/redis.conf
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/leanschool/redis /var/log/leanschool

[Install]
WantedBy=multi-user.target
