[Unit]
Description=LEAN SCHOOL full-module Java backend
After=network.target mysql.service leanschool-redis.service
Requires=leanschool-redis.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=leanschool
Group=leanschool
WorkingDirectory=/opt/leanschool/java/current
EnvironmentFile=/etc/leanschool/java.env
ExecStartPre=/usr/bin/python3 /opt/leanschool/deploy/preflight.py --jar /opt/leanschool/java/current/yudao-server.jar --manifest /opt/leanschool/java/current/release.json --java /opt/leanschool/jdk/bin/java --production --check-local-services
ExecStart=/opt/leanschool/jdk/bin/java $JAVA_OPTS -jar /opt/leanschool/java/current/yudao-server.jar --spring.profiles.active=prod --spring.config.additional-location=file:/etc/leanschool/application-prod.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/leanschool /var/log/leanschool
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
