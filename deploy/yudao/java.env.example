# Template only; root owns the real /etc/leanschool/java.env with mode 0600.
# systemd EnvironmentFile syntax, not a shell script. No export statements.
LS_DB_NAME=leanschool
LS_DB_PORT=3306
LS_DB_USER=leanschool_app
LS_DB_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
LS_REDIS_PORT=6382
LS_REDIS_DB=0
LS_REDIS_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
LS_FIELD_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_ALPHANUMERIC
LS_PUBLIC_ORIGIN=https://www.leanschool.net
LS_ADMIN_URL=https://www.leanschool.net/console/
LS_PUBLIC_TENANT_ID=1
LS_OPERATIONS_ENABLED=false
LS_OPERATIONS_SECRET=
LS_MEMBER_ORDERS_ENABLED=false
LS_MEMBER_ORDERS_SECRET=
# Budget example from local launch, not a measured production capacity promise.
JAVA_OPTS=-Xms256m -Xmx2304m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8 -Djava.awt.headless=true
