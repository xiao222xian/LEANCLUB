# Managed by bojizhuye deploy/ubuntu. Do not reuse for another application.
# A named virtual host, deliberately not a default_server.
server {
    listen @@HTTP_PORT@@;
    server_name @@HOST@@;
    root /opt/bojizhuye/current/web/creator;
    index index.html;
    autoindex off;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;

    location ^~ /api/ {
        client_max_body_size 9m;
        client_body_timeout 20s;
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
        proxy_request_buffering on;
        proxy_pass http://127.0.0.1:5381;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Original Origin, Referer, Cookie, X-CSRF-Token and Sec-Fetch-Site
        # are forwarded unchanged. Do not invent an Origin for the client.
        proxy_cache off;
    }

    location = / { try_files /index.html =404; }
    location = /schools { try_files /lean-school-ranking.html =404; }
    location = /join { try_files /school-submit.html =404; }
    location = /design { try_files /design/index.html =404; }
    location = /design/ { try_files /design/index.html =404; }
    location = /city-vote { try_files /city-vote/index.html =404; }
    location = /city-vote/ { try_files /city-vote/index.html =404; }
    location = /admin { try_files /admin/index.html =404; }
    location = /admin/ { try_files /admin/index.html =404; }
    location = /legacy-admin { try_files /admin/index.html =404; }
    location = /legacy-admin/ { try_files /admin/index.html =404; }
    location = /events { try_files /events/index.html =404; }
    location = /events/ { try_files /events/index.html =404; }
    location = /ticket { try_files /ticket/index.html =404; }
    location = /ticket/ { try_files /ticket/index.html =404; }
    location = /check-in { try_files /check-in/index.html =404; }
    location = /check-in/ { try_files /check-in/index.html =404; }
    location ~ /\. { deny all; }
    location ~* \.(?:html|css|js)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location / { try_files $uri =404; }
}
@@IP_REDIRECT_BLOCK@@
